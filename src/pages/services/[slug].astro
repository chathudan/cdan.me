---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

/** Which contact-form option each service should preselect. Anything not
 *  listed falls through to "Something else", so adding a service never
 *  produces a broken deep link. */
const enquiryTopic: Record<string, string> = {
  'web-app-development': 'web-app',
  'mobile-app-development': 'mobile-app',
  'pay-as-you-go': 'pay-as-you-go',
};

const { entry } = Astro.props;
const { Content } = await entry.render();
const canonical = new URL(`/services/${entry.slug}/`, site.url).href;
const schema = [
  serviceSchema({ name: entry.data.title, description: entry.data.summary, url: canonical }),
  breadcrumbSchema([
    { name: 'Home', url: `${site.url}/` },
    { name: 'Services', url: `${site.url}/services/` },
    { name: entry.data.title, url: canonical },
  ]),
];
---

<Base title={entry.data.title} description={entry.data.summary} schema={schema}>
  <article class="prose">
    <a href="/services/" class="back">← All services</a>
    <span class="eyebrow">Service</span>
    <h1>{entry.data.title}</h1>
    <p class="lede muted">{entry.data.summary}</p>
    <div class="body">
      <Content />
    </div>
    <hr />
    <div class="cta">
      <p>Interested? Tell me what you need — it takes a minute.</p>
      <a href={`/contact/?package=${enquiryTopic[entry.slug] ?? 'other'}`} class="button primary">
        Enquire about {entry.data.title}
      </a>
    </div>
  </article>
</Base>

<style>
  .prose { max-width: var(--measure); }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: none;
    margin-bottom: 1.5rem;
  }
  .back:hover { color: var(--accent); }
  .lede { font-size: 1.2rem; margin: 1rem 0 2rem; }
  .body :global(h2) { margin-top: 2.5em; }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
</style>
