---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="prose">
    <a href="/services/" class="back">← All services</a>
    <span class="eyebrow">Service</span>
    <h1>{entry.data.title}</h1>
    <p class="lede muted">{entry.data.summary}</p>
    <div class="body">
      <Content />
    </div>
    <hr />
    <div class="cta">
      <p>Interested? The easiest first step is a quick email.</p>
      <a href={`mailto:${site.email}?subject=${encodeURIComponent(entry.data.title + ' — inquiry')}`} class="button primary">
        Email about {entry.data.title}
      </a>
    </div>
  </article>
</Base>

<style>
  .prose { max-width: var(--measure); }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: none;
    margin-bottom: 1.5rem;
  }
  .back:hover { color: var(--accent); }
  .lede { font-size: 1.2rem; margin: 1rem 0 2rem; }
  .body :global(h2) { margin-top: 2.5em; }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
</style>
