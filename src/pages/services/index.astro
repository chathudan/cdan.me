---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site } from '../../site.config';
import { businessSchema, breadcrumbSchema } from '../../lib/schema';

const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);

const description =
  'Backend and web engineering, mobile apps, consulting, workflow automation, and overseas development teams — bought as a project or by the hour.';
const schema = [
  businessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: `${site.url}/` },
    { name: 'Services', url: `${site.url}/services/` },
  ]),
];
---

<Base title="Services" description={description} schema={schema}>
  <header class="page-head">
    <span class="eyebrow">Services</span>
    <h1>What I do.</h1>
    <p class="muted lede">
      A short menu of engagements I take on. Most of it can be bought as a
      project or simply <a href="/services/pay-as-you-go/">by the hour</a> —
      reach out and we'll figure out what makes sense.
    </p>
  </header>

  <div class="grid">
    {services.map((s) => (
      <ServiceCard
        href={`/services/${s.slug}/`}
        title={s.data.title}
        summary={s.data.summary}
        icon={s.data.icon}
      />
    ))}
  </div>
</Base>

<style>
  .page-head { max-width: 40rem; margin-bottom: 2.5rem; }
  .lede { font-size: 1.15rem; margin-top: 1rem; }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
